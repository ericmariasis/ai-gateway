+// observeUpgrade timestamps events on the runner, independently of CI log delivery.
+func observeUpgrade(testName, event, format string, args ...any) {
+	fmt.Printf("UPGRADE_OBS time=%s test=%s event=%s %s\n",
+		time.Now().UTC().Format(time.RFC3339Nano), testName, event, fmt.Sprintf(format, args...))
+}
+
+// observeUpgradePods watches transitions independently of the readiness gate.
+func observeUpgradePods(t *testing.T) context.CancelFunc {
+	ctx, cancel := context.WithCancel(t.Context())
+	testName := t.Name()
+	go func() {
+		cmd := e2elib.Kubectl(ctx, "get", "pods", "-n", e2elib.EnvoyGatewayNamespace,
+			"-l", egSelector, "--watch", "--output-watch-events", "-o", "json")
+		cmd.Stdout = nil
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			observeUpgrade(testName, "watch_error", "error=%q", err.Error())
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			observeUpgrade(testName, "watch_error", "error=%q", err.Error())
+			return
+		}
+		defer func() {
+			if err := cmd.Wait(); err != nil && ctx.Err() == nil {
+				observeUpgrade(testName, "watch_error", "error=%q", err.Error())
+			}
+		}()
+		decoder := json.NewDecoder(stdout)
+		last := map[string]string{}
+		for {
+			var event struct {
+				Type   string
+				Object corev1.Pod
+			}
+			if err := decoder.Decode(&event); err != nil {
+				if ctx.Err() == nil {
+					observeUpgrade(testName, "watch_error", "error=%q", err.Error())
+				}
+				return
+			}
+			pod := &event.Object
+			if pod.Name == "" {
+				continue
+			}
+			ready := corev1.ConditionUnknown
+			for _, condition := range pod.Status.Conditions {
+				if condition.Type == corev1.PodReady {
+					ready = condition.Status
+					break
+				}
+			}
+			terminating := "none"
+			if pod.DeletionTimestamp != nil {
+				terminating = pod.DeletionTimestamp.Time.UTC().Format(time.RFC3339Nano)
+			}
+			sidecar := false
+			for _, containers := range [][]corev1.Container{pod.Spec.InitContainers, pod.Spec.Containers} {
+				for _, container := range containers {
+					if container.Name == "ai-gateway-extproc" {
+						sidecar = true
+					}
+				}
+			}
+			state := fmt.Sprintf("name=%s ready=%s terminating=%s sidecar=%t", pod.Name, ready, terminating, sidecar)
+			if state != last[pod.Name] || event.Type == "DELETED" {
+				observeUpgrade(testName, "pod", "action=%s %s", event.Type, state)
+				last[pod.Name] = state
+			}
+		}
+	}()
+	return cancel
+}
